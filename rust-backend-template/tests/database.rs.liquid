// `use actix_web::test` shadows the built-in `#[test]`, so this synchronous test names it by path.
#[::core::prelude::v1::test]
fn the_closed_port_stays_reserved_while_the_test_holds_it() {
    let (config, port) = closed_port_config(None);
    let address = port.local_addr().unwrap();
    let url = url::Url::parse(config.database.url.as_str()).unwrap();
    assert_eq!(url.socket_addrs(|| None).unwrap(), [address]);
    assert!(
        TcpListener::bind(address).is_err(),
        "another process could bind {address}"
    );
}

#[actix_web::test]
async fn the_pool_uses_the_configured_acquire_timeout_and_10_seconds_by_default() {
    for (value, seconds) in [(None, 10), (Some("1"), 1), (Some("300"), 300)] {
        let (config, _port) = closed_port_config(value);
        let database = create_pool(&config.database).unwrap();
        assert_eq!(
            database.options().get_acquire_timeout(),
            Duration::from_secs(seconds)
        );
        assert_eq!(database.size(), 0);
        database.close().await;
    }
}

#[actix_web::test]
async fn acquiring_from_a_closed_port_times_out_after_the_configured_wait() {
    let (config, _port) = closed_port_config(Some("1"));
    let database = create_pool(&config.database).unwrap();
    let started = Instant::now();
    let error = database.acquire().await.unwrap_err();
    let elapsed = started.elapsed();
    assert!(
        matches!(error, sqlx::Error::PoolTimedOut),
        "expected a pool timeout, got {error:?}"
    );
    assert!(
        elapsed >= Duration::from_secs(1),
        "gave up after {elapsed:?}"
    );
    assert!(elapsed < Duration::from_secs(5), "waited {elapsed:?}");
    database.close().await;
}

{% if include_tasks %}/// Sends one task creation request to an app that stores tasks in `database`.
async fn post_a_task(config: Config, database: &PgPool) -> ServiceResponse<impl MessageBody> {
    let app = test::init_service(create_app(
        config.http,
        container_for(database),
        #[cfg(feature = "api-doc")]
        config.api_doc,
    ))
    .await;
    test::call_service(
        &app,
        test::TestRequest::post()
            .uri("/v1/tasks")
            .set_json(json!({"title": "Write documentation"}))
            .to_request(),
    )
    .await
}

#[actix_web::test]
async fn creating_a_task_fails_with_500_after_the_acquire_timeout_when_the_database_is_down() {
    let (config, _port) = closed_port_config(Some("1"));
    let database = create_pool(&config.database).unwrap();
    let started = Instant::now();
    let response = post_a_task(config, &database).await;
    let elapsed = started.elapsed();
    assert_eq!(response.status(), StatusCode::INTERNAL_SERVER_ERROR);
    assert_eq!(
        response.headers().get(CONTENT_TYPE).unwrap(),
        "application/problem+json"
    );
    assert_eq!(
        test::read_body_json::<Value, _>(response).await,
        json!({"title": "Internal Server Error", "status": 500}),
    );
    assert!(
        elapsed >= Duration::from_secs(1),
        "answered after {elapsed:?}"
    );
    assert!(elapsed < Duration::from_secs(5), "waited {elapsed:?}");
    database.close().await;
}

#[::core::prelude::v1::test]
fn a_pool_timeout_logs_its_own_reason_without_connection_details() {
    let output = std::process::Command::new(std::env::current_exe().unwrap())
        .args([
            "--ignored",
            "--exact",
            "pool_timeout_log_probe",
            "--nocapture",
        ])
        .output()
        .unwrap();
    assert!(
        output.status.success(),
        "{}",
        String::from_utf8_lossy(&output.stderr)
    );
    let logs = String::from_utf8(output.stdout).unwrap();
    for detail in ["postgres://", "closed_probe", "timed out"] {
        assert!(!logs.contains(detail), "{detail} in {logs}");
    }
    let events: Vec<Value> = logs
        .lines()
        .filter_map(|line| serde_json::from_str(line).ok())
        .collect();
    let storage = events
        .iter()
        .find(|event| event["message"] == "task persistence failed")
        .expect("the storage failure must be logged");
    assert_eq!(storage["level"], "ERROR");
    assert_eq!(storage["reason"], "pool_timeout");
    let route = events
        .iter()
        .find(|event| event["message"] == "task operation failed")
        .expect("the route failure must still be logged");
    assert_eq!(route["reason"], "persistence");
}

#[actix_web::test]
#[ignore = "invoked by the parent test in a fresh process to isolate tracing's subscriber cache"]
async fn pool_timeout_log_probe() {
    telemetry::init("info", LogFormat::Json);
    let (config, _port) = closed_port_config(Some("1"));
    let database = create_pool(&config.database).unwrap();
    let response = post_a_task(config, &database).await;
    assert_eq!(response.status(), StatusCode::INTERNAL_SERVER_ERROR);
    database.close().await;
}

{% endif %}#[actix_web::test]
async fn health_answers_at_once_when_the_database_port_is_closed() {
    let (config, _port) = closed_port_config(None);
    let database = create_pool(&config.database).unwrap();
    let app = test::init_service(create_app(
        config.http,
        container_for(&database),
        #[cfg(feature = "api-doc")]
        config.api_doc,
    ))
    .await;
    let started = Instant::now();
    let response =
        test::call_service(&app, test::TestRequest::get().uri("/health").to_request()).await;
    let elapsed = started.elapsed();
    assert_eq!(response.status(), StatusCode::OK);
    // The default acquire timeout is 10 seconds; health must not wait for any of it.
    assert!(elapsed < Duration::from_secs(1), "waited {elapsed:?}");
    assert_eq!(database.size(), 0);
    assert_eq!(database.num_idle(), 0);
    database.close().await;
}

#[actix_web::test]
async fn invalid_connection_options_do_not_escape_in_startup_errors() {
    let config = Config::from_lookup(|name| {
        (name == "DATABASE_URL")
            .then(|| {
                "postgres://user:secret-password@localhost/db?sslmode=secret-invalid-mode"
                    .to_owned()
            })
            .or_else(|| {
                (name == "API_DOC_PASSWORD").then(|| "documentation-test-password".to_owned())
            })
    })
    .unwrap();
    let error = create_pool(&config.database).unwrap_err();
    for rendered in [error.to_string(), format!("{error:?}")] {
        assert!(rendered.contains("DATABASE_URL"));
        assert!(!rendered.contains("secret"));
        assert!(!rendered.contains("postgres://"));
    }
}
