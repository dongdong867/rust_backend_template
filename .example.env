# Copy to .env for local runs; `make run` loads it. Placeholders only: never put real secrets here.
PORT=8080
RUST_LOG=info
LOG_FORMAT=pretty
HTTP_CORS_ENABLED=true
HTTP_CORS_ALLOWED_ORIGINS=
HTTP_REQUEST_TIMEOUT_SECS=30
HTTP_REQUEST_BODY_LIMIT_BYTES=1048576
DATABASE_URL=postgres://localhost/rust_backend_template
DATABASE_MAX_CONNECTIONS=10
# Optional documentation: run with FEATURES=api-doc to enable /docs/.
# API_DOC_USERNAME defaults to docs when absent; supply a valid override only if needed.
# API_DOC_PASSWORD must be supplied and nonempty when enabled; there is no default.
# Set documentation credentials in the deployment environment or ignored .env, never here.
# Use HTTPS at the ingress; documentation Basic auth does not protect API routes.
