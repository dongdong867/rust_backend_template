# Every target runs from the repository root. CI calls the same targets.

TAPLO_VERSION := 0.10.0
CARGO_DENY_VERSION := 0.20.2
{% if template_source %}CARGO_GENERATE_VERSION := 0.25.0
ACTIONLINT_VERSION := 1.7.12
{% endif %}FEATURES ?=
COMPOSE_HEALTH_SECONDS ?= 30
CARGO_FEATURES = $(if $(strip $(FEATURES)),--features "$(FEATURES)")
IMAGE := {{project-name}}:local

.DEFAULT_GOAL := help
.PHONY: help run migrate build test test-crate test-db {% if template_source %}template-test template-test-fast template-tools ci-tools ci-config-check {% endif %}tool-versions fmt fmt-check fmt-toml-check clippy lint audit check hooks-install tools taplo-version cargo-deny-version image compose-up compose-down compose-migrate compose-settings compose-health

help: ## List the targets
	@awk 'BEGIN {FS = ":.*## "} /^[a-z-]+:.*## / {printf "  %-15s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

run: ## Run the service, loading .env when it exists
	set -a; [ ! -f .env ] || . ./.env; set +a; cargo run --locked $(CARGO_FEATURES)

migrate: ## Apply PostgreSQL migrations deliberately, loading .env when it exists
	set -a; [ ! -f .env ] || . ./.env; set +a; cargo run --locked $(CARGO_FEATURES) --bin migrate

build: ## Build the release binary
	cargo build --locked --release $(CARGO_FEATURES)

test: ## Run fast tests without PostgreSQL
	cargo test --locked --workspace $(CARGO_FEATURES)
{% if template_source %}	python3 -m unittest discover -s scripts/tests -p 'test_*.py'
{% endif %}
test-crate: export CRATE ?=
test-crate: export FEATURES ?=
test-crate: ## Test one workspace package (CRATE=<exact package name>)
	python3 .github/ci/test_crate.py

test-db: ## Run real SQL tests on an existing server (requires TEST_DATABASE_URL)
	@test -n "$${TEST_DATABASE_URL:-}" || { echo "TEST_DATABASE_URL is required; use a dedicated PostgreSQL test server with CREATEDB permission." >&2; exit 1; }
	@cargo test --locked -p {{project-name}} $(CARGO_FEATURES) --test postgres_database -- --ignored
{% if include_tasks %}	@DATABASE_URL="$$TEST_DATABASE_URL" cargo test --locked -p tasks $(CARGO_FEATURES) --test postgres_task_repository -- --ignored
{% endif %}
image: ## Build the production container image
	docker build --build-arg FEATURES="$(FEATURES)" --tag $(IMAGE) .

compose-settings:
	@test -f "$${SERVICE_ENV_FILE:-.env}" || { echo "$${SERVICE_ENV_FILE:-.env} is missing; copy .example.env and reach PostgreSQL as host.docker.internal." >&2; exit 1; }

compose-up: compose-settings image ## Run the service container against an existing PostgreSQL, reading .env or SERVICE_ENV_FILE
	docker compose --env-file "$${SERVICE_ENV_FILE:-.env}" up --detach --no-build --wait
	@$(MAKE) --no-print-directory compose-health

# A container that exits at startup restarts in a loop, which `--wait` counts as running,
# so the start counts only once GET /health answers. Docker names the service's address;
# a restarting container has none yet, which counts as not answering.
compose-health:
	@end=$$(( $$(date +%s) + $(COMPOSE_HEALTH_SECONDS) )); seen=; \
	while [ "$$(date +%s)" -lt "$$end" ]; do \
	  address="$$(docker compose --env-file "$${SERVICE_ENV_FILE:-.env}" port service 8080 2>/dev/null)"; \
	  [ -z "$$address" ] || seen="$$address"; \
	  [ -n "$$address" ] && curl -fs --max-time 2 -o /dev/null "http://$$address/health" && exit 0; sleep 1; \
	done; \
	if [ -n "$$seen" ]; then echo "GET http://$$seen/health did not return 200 within $(COMPOSE_HEALTH_SECONDS) s; the service log follows." >&2; \
	else echo "No published address for the service was found within $(COMPOSE_HEALTH_SECONDS) s; the service log follows." >&2; fi; \
	docker compose --env-file "$${SERVICE_ENV_FILE:-.env}" logs --no-color --tail 50 service >&2; exit 1

compose-down: ## Stop and remove the service container
	docker compose down

compose-migrate: compose-settings image ## Apply migrations from the image, reading .env or SERVICE_ENV_FILE
	docker compose --env-file "$${SERVICE_ENV_FILE:-.env}" run --rm migrate

{% if template_source %}template-test: ## Generate both variants and run their full checks (requires TEST_DATABASE_URL)
	python3 scripts/template_test.py

template-test-fast: ## Generate both variants and run lint, audit and fast tests without PostgreSQL
	python3 scripts/template_test.py --fast-only

template-tools: ## Install the pinned generator locally for template verification
	cargo install --locked --version $(CARGO_GENERATE_VERSION) --root .tools cargo-generate

ci-tools: ## Install the pinned workflow checker locally with checksum verification
	python3 scripts/install_actionlint.py --version $(ACTIONLINT_VERSION)

ci-config-check: ci-tools ## Check the actual GitHub Actions workflows
	python3 scripts/check_ci.py

{% endif %}tool-versions: ## Print tool pins for CI without duplicating versions in workflows
	@printf 'taplo=%s\ncargo-deny=%s\n{% if template_source %}cargo-generate=%s\nactionlint=%s\n{% endif %}' '$(TAPLO_VERSION)' '$(CARGO_DENY_VERSION)'{% if template_source %} '$(CARGO_GENERATE_VERSION)' '$(ACTIONLINT_VERSION)'{% endif %}

fmt: taplo-version ## Format Rust and TOML files
	cargo fmt --all
	RUST_LOG=warn taplo fmt

fmt-check: ## Check Rust formatting
	cargo fmt --all --check

fmt-toml-check: taplo-version ## Check TOML formatting
	RUST_LOG=warn taplo fmt --check

clippy: ## Run Clippy, failing on any warning
	cargo clippy --locked --workspace --all-targets --all-features -- -D warnings -D clippy::too_many_lines

lint: fmt-check fmt-toml-check clippy ## Run every static check

audit: cargo-deny-version ## Check Cargo.lock for advisories, licenses and sources; needs network
	cargo-deny --locked check

check: lint test test-db audit ## Run the full pre-publication check (requires TEST_DATABASE_URL)

hooks-install: ## Use the pre-commit hook in .githooks
	git config core.hooksPath .githooks

tools: ## Install the pinned Taplo and cargo-deny CLIs
	cargo install --locked taplo-cli --version $(TAPLO_VERSION)
	cargo install --locked cargo-deny --version $(CARGO_DENY_VERSION)

taplo-version:
	@taplo --version 2>/dev/null | grep -qx 'taplo $(TAPLO_VERSION)' || { echo "Taplo $(TAPLO_VERSION) is required. Run: make tools" >&2; exit 1; }

cargo-deny-version:
	@cargo-deny --version 2>/dev/null | grep -qx 'cargo-deny $(CARGO_DENY_VERSION)' || { echo "cargo-deny $(CARGO_DENY_VERSION) is required. Run: make tools" >&2; exit 1; }
