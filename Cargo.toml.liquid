[workspace]
members = ["{{project-name}}", "crates/*"]
resolver = "3"

[workspace.dependencies]
actix-cors = { version = "0.7.1", default-features = false }
actix-web = { version = "4.15.0", default-features = false, features = ["macros"] }
actix-web-httpauth = "0.8.2"
{% if include_tasks %}async-trait = "0.1.89"
chrono = { version = "0.4.42", features = ["serde"] }
{% endif %}serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
subtle = "2.6.1"
utoipa = { version = "6.0.0", features = ["chrono", "uuid"] }
utoipa-swagger-ui = { version = "10.0.1", default-features = false, features = [
  "actix-web",
  "vendored",
] }
sqlx = { version = "0.9.0", default-features = false, features = [
  "runtime-tokio",
  "tls-rustls-ring-native-roots",
  "postgres",
{% if include_tasks %}  "chrono",
  "uuid",
{% endif %}  "migrate",
  "macros",
] }
thiserror = "2.0.21"
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["env-filter", "json"] }
url = "2.5.8"
uuid = { version = "1.26.1", features = ["serde", "v4"] }

environment.path = "crates/environment"
{% if include_tasks %}tasks.path = "crates/tasks"
{% endif -%}
